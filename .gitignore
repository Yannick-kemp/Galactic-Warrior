# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Visual Studio / MonoDevelop project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity autogenerated files
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash and error files
sysinfo.txt
crash*

# Files related to settings and packages (only exclude if using version control for specific settings)
*.swp
.DS_Store
Thumbs.db

# File locking for Unity
*.lock

# Unity asset cache
*.stacktrace

# Non-essential files from Unity
.vs/
.vscode/
.idea/

# TextMeshPro generated files
*.asset

# JetBrains Rider and IDE files
.idea/
*.idea/
*.iml

# Exclude build artifacts
Build/
Builds/
*.apk
*.aab

# Ignore specific user settings
*.log
*.stacktrace

# Ignore auto-generated code
/Generated/**

# Cache files
[Cache]/

# Exclude Unity Collaborate
/[Cc]ollab/

# Other temporary files
[Tt]emp/
* . a p k 

*.mp4

packages-lock.json

 
 