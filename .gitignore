# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Visual Studio / MonoDevelop project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity autogenerated files
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash and error files
sysinfo.txt
crash*

# Files related to settings and packages (only exclude if using version control for specific settings)
*.swp
.DS_Store
Thumbs.db

# File locking for Unity
*.lock

# Unity asset cache
*.stacktrace

# Non-essential files from Unity
.vs/
.vscode/
.idea/

# NOTE: do NOT add "*.asset" here. That glob excludes ALL Unity .asset files —
# ProjectSettings (Tags/Layers, Physics2D matrix, Input) and every ScriptableObject —
# which breaks cross-machine sync (scenes reference config that never travels).
# Unity .asset files are meant to be committed.

# JetBrains Rider and IDE files
.idea/
*.idea/
*.iml

# Per-user editor state — never commit (machine-specific, may hold credentials)
/UserSettings/

# Exclude build artifacts
Build/
Builds/
Artefacs/       
*.apk
*.aab
*.symbols.zip

# Android release signing — NEVER commit the keystore or its passwords
*.keystore
*.jks
keystore.properties

# Ignore specific user settings
*.log
*.stacktrace

# Ignore auto-generated code
/Generated/**

# Cache files
[Cache]/

# Exclude Unity Collaborate
/[Cc]ollab/

# Other temporary files
[Tt]emp/
* . a p k 

*.mp4

# NOTE: do NOT ignore packages-lock.json — commit it so the whole team resolves
# the exact same package versions (avoids "works on my machine" package drift).

 
 